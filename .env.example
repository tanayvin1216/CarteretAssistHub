# Supabase — shared with FoodAssist. Use the SAME project.
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS. Never expose to client.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only, used by the scripts in scripts/ (never by the app itself).
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI).
# Needed to apply migrations and seeds from the command line; if you would
# rather not store it, paste supabase/resource-directory-install.sql into the
# dashboard's SQL editor instead.
DATABASE_URL=
